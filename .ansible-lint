---
# ==============================================================================
# UrbanPulse Ansible Lint Configuration
# ==============================================================================
profile: production

exclude_paths:
  - .venv/
  - venv/
  - data/
  - .github/
  - scratch/

skip_list:
  - risky-shell-pipe  # Pipe in curl | sh is required by the official k3s automated installation script
  - command-instead-of-module  # Direct shell installer and kubectl commands are used without requiring heavy external python dependencies
  - var-naming  # Allow flexible role variable naming across custom deployment playbooks